install.packages("ggplot2")
library(ISLR2)
library(animation)
# 1. Carregar o dataset Default
data(Default)
# 2. Ajustar regressao logistica: default ~ balance + student + income
modelo <- glm(default ~ balance + student + income,
family = binomial, data = Default)
# 3. Obter probabilidades preditas
prob <- predict(modelo, type = "response")
# Rotulos verdadeiros em formato binario (Yes = 1, No = 0)
y <- as.integer(Default$default == "Yes")
# 4. Calcular Sensibilidade, Especificidade e FPR para cada limiar (0 a 1, passo 0.01)
thresholds_all <- seq(0, 1, by = 0.01)
roc <- data.frame(threshold = thresholds_all,
TPR = NA, TNR = NA, FPR = NA)
for (i in seq_along(thresholds_all)) {
thr <- thresholds_all[i]
pred <- as.integer(prob >= thr)
TP <- sum(pred == 1 & y == 1)
FP <- sum(pred == 1 & y == 0)
TN <- sum(pred == 0 & y == 0)
FN <- sum(pred == 0 & y == 1)
TPR <- TP / (TP + FN)        # Sensibilidade
TNR <- TN / (TN + FP)        # Especificidade
FPR <- 1 - TNR               # Taxa de Falsos Positivos
roc$TPR[i] <- TPR
roc$TNR[i] <- TNR
roc$FPR[i] <- FPR
}
# Calcular AUC pela regra do trapezio (ordenando por FPR)
roc_sorted <- roc[order(roc$FPR), ]
auc <- sum((roc_sorted$FPR[-1] - roc_sorted$FPR[-nrow(roc_sorted)]) *
(roc_sorted$TPR[-1] + roc_sorted$TPR[-nrow(roc_sorted)]) / 2)
# Encontrar ponto otimo pelo indice de Youden (maximiza Sens + Espec - 1)
roc$youden <- roc$TPR + roc$TNR - 1
opt_idx <- which.max(roc$youden)
opt <- roc[opt_idx, ]
# 5. Frames da animacao: limiares de 1 a 0, passo 0.05 (21 frames)
frame_thresholds <- seq(1, 0, by = -0.05)
# 6. Criar o GIF animado
saveGIF({
for (ft in frame_thresholds) {
# Pontos ja construidos da curva (limiares >= limiar atual)
shown <- roc[roc$threshold >= ft - 1e-8, ]
# Ponto atual: limiar mais proximo do frame
cur_idx <- which.min(abs(roc$threshold - ft))
cur <- roc[cur_idx, ]
par(bg = "white", mar = c(5.2, 5.2, 4, 2))
plot(NULL, xlim = c(0, 1), ylim = c(0, 1),
xlab = "Taxa de Falsos Positivos (1 - Especificidade)",
ylab = "Taxa de Verdadeiros Positivos (Sensibilidade)",
main = "Curva ROC - Dataset Default (ISLR2)",
las = 1, bty = "l")
# Linha diagonal de referencia (linha de chance)
abline(0, 1, lty = 2, col = "gray60", lwd = 1.5)
# Construir a curva ROC ponto a ponto
if (nrow(shown) > 1) {
lines(shown$FPR, shown$TPR, col = "steelblue", lwd = 2)
points(shown$FPR, shown$TPR, pch = 16, cex = 0.5, col = "steelblue")
}
# Marcar ponto otimo (estrela dourada) se ja estiver construido
if (opt$threshold >= ft - 1e-8) {
points(opt$FPR, opt$TPR, pch = 8, cex = 2.8, col = "gold", lwd = 2)
}
# Ponto atual: grande ponto vermelho
points(cur$FPR, cur$TPR, pch = 19, cex = 2.8, col = "red")
# Linha tracejada ligando o ponto a anotacao do limiar
annot_x <- 0.55
annot_y <- 0.45
segments(cur$FPR, cur$TPR, annot_x, annot_y, lty = 2, col = "red", lwd = 1.5)
text(annot_x, annot_y - 0.05,
labels = paste0("Limiar = ", sprintf("%.2f", ft)),
col = "red", font = 2, cex = 1.1)
# Legenda com AUC e informacoes
legend("bottomright",
legend = c(paste0("AUC = ", sprintf("%.3f", auc)),
paste0("Limiar otimo (Youden) = ", sprintf("%.2f", opt$threshold)),
"Linha de chance"),
lty = c(NA, NA, 2),
pch = c(19, 8, NA),
col = c("red", "gold", "gray60"),
pt.cex = c(1.5, 1.8, NA),
lwd = c(NA, 2, 1.5),
bty = "n", cex = 0.95)
}
}, movie.name = "curva_roc.gif", interval = 0.5, ani.width = 720, ani.height = 720)
cat("GIF salvo como curva_roc.gif\n")
cat("AUC =", round(auc, 4), "\n")
cat("Limiar otimo (Youden) =", round(opt$threshold, 4), "\n")
# --- Carregamento de pacotes ---
library(ISLR2)
# animation so e necessario na Parte 2; carrega condicionalmente
has_animation <- requireNamespace("animation", quietly = TRUE)
if (has_animation) {
library(animation)
}
# ============================================================
# Ajuste do modelo de regressao logistica
# ============================================================
data(Default)
# Converter a resposta "default" para binario (Yes = 1, No = 0)
Default$default_bin <- as.integer(Default$default == "Yes")
# Ajustar regressao logistica: default ~ balance + student + income
modelo <- glm(default_bin ~ balance + student + income,
data = Default, family = binomial)
# Probabilidades preditas
prob_pred <- predict(modelo, type = "response")
# Resposta observada
y_true <- Default$default_bin
# ============================================================
# Calculo da curva ROC para thresholds de 0 a 1 (passo 0.01)
# ============================================================
thresholds <- seq(0, 1, by = 0.01)
TPR <- numeric(length(thresholds))  # Sensibilidade
FPR <- numeric(length(thresholds))  # 1 - Especificidade
TNR <- numeric(length(thresholds))  # Especificidade
n_pos <- sum(y_true == 1)
n_neg <- sum(y_true == 0)
for (i in seq_along(thresholds)) {
thr <- thresholds[i]
pred <- as.integer(prob_pred >= thr)
TP <- sum(pred == 1 & y_true == 1)
FP <- sum(pred == 1 & y_true == 0)
TN <- sum(pred == 0 & y_true == 0)
FN <- sum(pred == 0 & y_true == 1)
TPR[i] <- TP / (TP + FN)  # Sensibilidade
TNR[i] <- TN / (TN + FP)  # Especificidade
FPR[i] <- 1 - TNR[i]      # 1 - Especificidade
}
# ============================================================
# Calculo do AUC pela regra do trapezoide
# ============================================================
# Ordenar por FPR crescente para aplicar a regra do trapezoide
ord <- order(FPR)
FPR_ord <- FPR[ord]
TPR_ord <- TPR[ord]
AUC <- sum((FPR_ord[-1] - FPR_ord[-length(FPR_ord)]) *
(TPR_ord[-1] + TPR_ord[-length(TPR_ord)]) / 2)
# ============================================================
# Threshold otimo pelo indice de Youden (maximiza TPR + TNR - 1)
# ============================================================
youden <- TPR + TNR - 1
idx_opt <- which.max(youden)
opt_threshold <- thresholds[idx_opt]
opt_FPR <- FPR[idx_opt]
opt_TPR <- TPR[idx_opt]
# Funcao auxiliar para desenhar a curva ROC estatica
# (reutilizada nas Partes 1 e 3)
desenha_roc_estatica <- function() {
par(bg = "white", bty = "l", las = 1, mar = c(5, 5, 4, 2) + 0.1)
# Linha de referencia diagonal (cinza, tracejada)
plot(0, 0, type = "n",
xlim = c(0, 1), ylim = c(0, 1),
xlab = "Taxa de Falsos Positivos (1 - Especificidade)",
ylab = "Taxa de Verdadeiros Positivos (Sensibilidade)",
main = "Curva ROC \u2014 Regress\u00e3o Log\u00edstica (Dataset Default)")
abline(0, 1, col = "gray", lty = 2, lwd = 1.5)
# Curva ROC: linha steelblue com pontos
lines(FPR, TPR, col = "steelblue", lwd = 2)
points(FPR, TPR, col = "steelblue", pch = 16, cex = 0.8)
# Ponto otimo: estrela/diamante dourado
points(opt_FPR, opt_TPR, pch = 8, cex = 2.5, col = "gold", lwd = 2)
# Anotacao do threshold otimo ao lado do ponto dourado
text(opt_FPR, opt_TPR,
labels = paste0("threshold = ", round(opt_threshold, 2)),
pos = 4, offset = 0.6, col = "black", cex = 0.9)
# Legenda com AUC
legend("bottomright",
legend = paste0("AUC = ", round(AUC, 4)),
lty = 1, lwd = 2, col = "steelblue",
bty = "o", bg = "white")
}
# Salvar figura estatica em PNG 720x720
png("curva_roc_estatica.png", width = 720, height = 720, res = 120)
desenha_roc_estatica()
dev.off()
cat("Parte 1 concluida: curva_roc_estatica.png gerada.\n")
# Frames: threshold de 1.0 ate 0.0, passo 0.05 (21 frames)
frame_thresholds <- seq(1.0, 0.0, by = -0.05)
# Funcao que desenha um unico frame do GIF
desenha_frame_roc <- function(frame_thr) {
par(bg = "white", bty = "l", las = 1, mar = c(5, 5, 4, 2) + 0.1)
plot(0, 0, type = "n",
xlim = c(0, 1), ylim = c(0, 1),
xlab = "Taxa de Falsos Positivos (1 - Especificidade)",
ylab = "Taxa de Verdadeiros Positivos (Sensibilidade)",
main = "Curva ROC \u2014 Constr\u00e7\u00e3o animada (Dataset Default)")
# Linha de referencia diagonal
abline(0, 1, col = "gray", lty = 2, lwd = 1.5)
# Pontos ja visitados: threshold >= frame_thr (em steelblue)
visitados <- thresholds >= frame_thr - 1e-9
if (sum(visitados) > 1) {
lines(FPR[visitados], TPR[visitados], col = "steelblue", lwd = 2)
}
points(FPR[visitados], TPR[visitados], col = "steelblue", pch = 16, cex = 0.8)
# Ponto atual: ponto vermelho grande
# Encontrar o indice do threshold mais proximo do frame_thr
idx_atual <- which.min(abs(thresholds - frame_thr))
cur_FPR <- FPR[idx_atual]
cur_TPR <- TPR[idx_atual]
points(cur_FPR, cur_TPR, pch = 19, cex = 2.8, col = "red")
# Linha tracejada vermelha ligando o ponto atual a uma caixa de anotacao
# Caixa de anotacao posicionada no canto superior esquerdo
box_x <- 0.30
box_y <- 0.92
segments(cur_FPR, cur_TPR, box_x, box_y,
col = "red", lty = 2, lwd = 1.5)
rect(box_x - 0.18, box_y - 0.06, box_x + 0.18, box_y + 0.06,
col = "white", border = "red", lwd = 1.5)
text(box_x, box_y,
labels = paste0("threshold = ", round(frame_thr, 2)),
col = "red", cex = 0.9)
# Ponto otimo (Youden) como estrela dourada quando ja foi alcancado
# (ou seja, quando frame_thr <= opt_threshold)
if (frame_thr <= opt_threshold + 1e-9) {
points(opt_FPR, opt_TPR, pch = 8, cex = 2.5, col = "gold", lwd = 2)
}
# Legenda com AUC e threshold otimo
legend("bottomright",
legend = c(paste0("AUC = ", round(AUC, 4)),
paste0("Threshold \u00f3timo = ", round(opt_threshold, 2))),
lty = c(1, NA), lwd = c(2, NA),
col = c("steelblue", "gold"),
pch = c(NA, 8),
bty = "o", bg = "white")
}
# Gerar o GIF apenas se o pacote animation estiver disponivel
if (has_animation) {
saveGIF({
for (ft in frame_thresholds) {
desenha_frame_roc(ft)
}
}, movie.name = "curva_roc.gif", interval = 0.5,
ani.width = 720, ani.height = 720)
cat("Parte 2 concluida: curva_roc.gif gerada.\n")
} else {
cat("Parte 2: pacote 'animation' nao disponivel. GIF nao gerado.\n")
cat("Instale com: install.packages('animation') e install.packages('gifski')\n")
}
# Funcao que desenha o frame correspondente ao threshold otimo
# (versao do frame do GIF com destaque para o ponto otimo)
desenha_frame_otimo <- function() {
par(bg = "white", bty = "l", las = 1, mar = c(5, 5, 4, 2) + 0.1)
plot(0, 0, type = "n",
xlim = c(0, 1), ylim = c(0, 1),
xlab = "Taxa de Falsos Positivos (1 - Especificidade)",
ylab = "Taxa de Verdadeiros Positivos (Sensibilidade)",
main = "Frame do GIF \u2014 Threshold \u00f3timo (Youden)")
# Linha de referencia diagonal
abline(0, 1, col = "gray", lty = 2, lwd = 1.5)
# Pontos ja visitados ate o threshold otimo
visitados <- thresholds >= opt_threshold - 1e-9
if (sum(visitados) > 1) {
lines(FPR[visitados], TPR[visitados], col = "steelblue", lwd = 2)
}
points(FPR[visitados], TPR[visitados], col = "steelblue", pch = 16, cex = 0.8)
# Ponto atual (threshold otimo) em vermelho
idx_atual <- which.min(abs(thresholds - opt_threshold))
cur_FPR <- FPR[idx_atual]
cur_TPR <- TPR[idx_atual]
points(cur_FPR, cur_TPR, pch = 19, cex = 2.8, col = "red")
# Linha tracejada vermelha ligando o ponto atual a caixa de anotacao
box_x <- 0.30
box_y <- 0.92
segments(cur_FPR, cur_TPR, box_x, box_y,
col = "red", lty = 2, lwd = 1.5)
rect(box_x - 0.18, box_y - 0.06, box_x + 0.18, box_y + 0.06,
col = "white", border = "red", lwd = 1.5)
text(box_x, box_y,
labels = paste0("threshold = ", round(opt_threshold, 2)),
col = "red", cex = 0.9)
# Ponto otimo como estrela dourada (destaque principal)
points(opt_FPR, opt_TPR, pch = 8, cex = 2.5, col = "gold", lwd = 2)
# Legenda com AUC e threshold otimo
legend("bottomright",
legend = c(paste0("AUC = ", round(AUC, 4)),
paste0("Threshold \u00f3timo = ", round(opt_threshold, 2))),
lty = c(1, NA), lwd = c(2, NA),
col = c("steelblue", "gold"),
pch = c(NA, 8),
bty = "o", bg = "white")
}
# Salvar figura combinada em PNG 1400x600
png("curva_roc_comparacao.png", width = 1400, height = 600, res = 120)
par(mfrow = c(1, 2), bg = "white")
# Esquerda: curva estatica
desenha_roc_estatica()
# Direita: frame do GIF no threshold otimo
desenha_frame_otimo()
dev.off()
cat("Parte 3 concluida: curva_roc_comparacao.png gerada.\n")
# ============================================================
# Instrucoes de exibicao do GIF
# ============================================================
if (has_animation) {
cat("\nPara visualizar o GIF animado, abra o arquivo 'curva_roc.gif'\n")
